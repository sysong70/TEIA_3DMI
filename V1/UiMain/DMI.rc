    LTEXT           "Copyright (C) 2020", IDC_STATIC, 40,25,119,8
    DEFPUSHBUTTON   "OK", IDOK, 178,7,50,16, WS_GROUP
    PUSHBUTTON      "http://www.<MyCompany>.com", IDC_COMPANY_URL, 40,36,119,14
END

